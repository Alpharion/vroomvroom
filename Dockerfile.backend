# Backend API (FastAPI + LangGraph agents).
# Build from the repo root:  docker build -f Dockerfile.backend -t vroomvroom-backend .
# Configure with environment variables, never a baked-in .env:
#   ADP_APP_KEY=<key>  USE_MOCK_LLM=false   (USE_STUB_AGENTS must be unset)
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000

WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# The backend reads cases from data/ and policy clauses from docs/; the stub
# stream (USE_STUB_AGENTS=true) replays frontend/mock_agent_log.json.
COPY backend backend
COPY data data
COPY docs docs
COPY frontend/mock_agent_log.json frontend/mock_agent_log.json

WORKDIR /app/backend
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
