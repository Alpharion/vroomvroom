# Copy to .env and fill in. Never commit .env.
ADP_CHAT_URL=https://wss.lke.tencentcloud.com/adp/v2/chat
# Default AppKey for all agents. Per-agent overrides (optional):
#   ADP_APPKEY_RIDER_ADVOCATE, ADP_APPKEY_DRIVER_ADVOCATE, ADP_APPKEY_JUDGE
ADP_APP_KEY=

# Optional: model per request, overriding the ADP app's own model setting.
# Retries (after 60 s with no reply) use the fallback model, so a stalled model
# doesn't stall the hearing. On 14 Oct 2026 DeepSeek-V3.2 hung on ADP while
# Kimi-K2.5 answered in under 2 s.
ADP_MODEL_NAME=
ADP_FALLBACK_MODEL_NAME=Kimi-K2.5

# Reserved for a direct DeepSeek fallback if ADP quota runs out.
# Not read by any code yet.
DEEPSEEK_API_KEY=

# false = call ADP live (and save each reply to backend/.llm_cache/).
# true  = replay saved replies only, never call ADP. A prompt that has not been
#         run live before fails with "No cached response", so start with false.
USE_MOCK_LLM=false

# Replay mocked advocate/Judge messages instead of calling ADP (UI work only;
# never set this on the deployed backend)
USE_STUB_AGENTS=false
